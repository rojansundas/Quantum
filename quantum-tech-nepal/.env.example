# ── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here-change-me
DEBUG=False
ALLOWED_HOSTS=quantumtechnepal.com,www.quantumtechnepal.com
CORS_ALLOWED_ORIGINS=https://quantumtechnepal.com,https://www.quantumtechnepal.com

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=quantumtech
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@redis:6379/1

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=hello@quantumtechnepal.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Quantum Tech Nepal <hello@quantumtechnepal.com>

# ── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://quantumtechnepal.com/api/v1
API_URL=https://quantumtechnepal.com

# ── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── AWS S3 (optional for media storage) ────────────────────────────────────
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=quantum-tech-nepal-media
# AWS_S3_REGION_NAME=ap-south-1
